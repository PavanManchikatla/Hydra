+    // [HYDRA P2·10b] pipeline-shard LOAD window. Every architecture's load_arch_tensors() funnels
+    // through this one call, so the window is enforced ARCH-AGNOSTICALLY here rather than being
+    // re-patched per architecture (unlike the M-1 compute window, which had to live in each
+    // arch's graph builder). Two rules, both purely subtractive:
+    //   1. a block tensor (bid >= 0) outside the window is NOT created — so it is neither
+    //      required from the file nor allocated in any buffer. This is what makes the shard
+    //      load only its own layers' weights.
+    //   2. a global (bid == -1: token_embd / output_norm / output) becomes OPTIONAL, because a
+    //      shard carries token_embd only on the first stage and output* only on the last. It is
+    //      still created when the file HAS it, so the last stage keeps its real lm_head.
+    // Nothing here changes what any tensor MEANS or how it is computed — a shard-loaded model
+    // that is asked to run layers it did not load will null-deref rather than silently compute
+    // something wrong, and the caller (hydra_context_new) is what keeps the compute window
+    // inside the load window.
+    if (params.il_load_end >= 0) {
+        if (tn.bid >= 0 && (tn.bid < params.il_load_start || tn.bid >= params.il_load_end)) {
+            return nullptr;
+        }
+        if (tn.bid == -1) {
+            flags |= TENSOR_NOT_REQUIRED;
+        }
+    }
     const buft_list_t * buft_list_layer = tn.bid == -1 ? nullptr : pimpl->dev_layer.at(tn.bid).buft_list;
